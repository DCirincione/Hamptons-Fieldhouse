SUPABASE_URL=
SUPABASE_KEY=
# Server-only: required for booking availability/reservations and staff review.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only: read-only Printful catalog token and optional account-level store ID.
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
# Square Sandbox only. Access token is server-only.
SQUARE_ENVIRONMENT=sandbox
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_APPLICATION_ID=
SQUARE_SANDBOX_LOCATION_ID=
# Enable only after applying scripts/sql/square_booking_payments.sql.
SQUARE_BOOKING_PAYMENTS_ENABLED=false
SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
# Public site origin used in account confirmation links.
SITE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:8000"]
