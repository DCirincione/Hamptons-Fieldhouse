SUPABASE_URL=
SUPABASE_KEY=
# Server-only: required for booking availability/reservations and staff review.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only: read-only Printful catalog token and optional account-level store ID.
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
# Square environment. Access tokens and webhook signature keys are server-only.
SQUARE_ENVIRONMENT=sandbox
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_LOCATION_ID=
SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=
SQUARE_PRODUCTION_ACCESS_TOKEN=
SQUARE_PRODUCTION_LOCATION_ID=
SQUARE_PRODUCTION_WEBHOOK_SIGNATURE_KEY=
# Enable only after applying both Square booking checkout SQL scripts.
SQUARE_BOOKING_PAYMENTS_ENABLED=false
SQUARE_MERCH_CHECKOUT_ENABLED=false
# Flat standard shipping in cents. Set to 0 only when offering free shipping.
SQUARE_MERCH_SHIPPING_CENTS=0
SQUARE_WEBHOOK_URL=https://www.hamptonsfieldhouse.com/api/square/webhook
# Optional contact form email alerts via Gmail SMTP. Use a Google App Password,
# not the account's regular password; leave blank to store messages only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=hamptonsfieldhouse@gmail.com
SMTP_PASSWORD=
EMAIL_NOTIFICATION_TO=hamptonsfieldhouse@gmail.com
# Public site origin used in account confirmation links.
SITE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:8000"]
